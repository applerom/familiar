<Why_Graph_Shard project="Familiar" CAPABILITY="CAP-REGION">
  <!--
    One capability: the region pack contract and the packs that follow it.
    A pack is data and text for agents, not code; its files carry contracts in
    TOML comments or a Markdown comment. Guarantees that hold for every file of
    every pack sit on FEAT-REGION; a pack file keeps only its own promise.
    Edges to other capabilities live in docs/why-graph.xml.
  -->

  <!-- Table intake wording, sex vocabulary and conservative patronymic mappings are pack-owned. -->
  <FEATURE_REGION ID="FEAT-REGION" STATE="STARTED">
    <INTENT>A detachable pack of what is true of a place for any family from there: sources, custody and closure of records, calendars, borders and languages of records, answers to the skills' numbered questions; nothing of any one family.</INTENT>
    <PRD_REF>docs/PRD.md#LAYERS</PRD_REF>
    <PRD_REF>docs/PRD.md#ARCH</PRD_REF>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-PACK"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-SOURCES"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-CUSTODY"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-CHRONOLOGY"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-ANSWERS"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-DATA-CONTRACT"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-VARIANTS"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-RECIPES"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-RECIPE-GENETEKA"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-RECIPE-SZUKAJWARCHIWACH"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-RECIPE-PAMYAT-NARODA"/>
    <REL TYPE="IMPLEMENTED_BY" TARGET="MOD-REGION-BP-RECIPE-OBD-MEMORIAL"/>
    <INVARIANT REVIEW="pack keeper">a pack holds no person, family, case or family search: every capitalised name is declared by kind in pack.toml, and long identifiers, file-level archive references, paths and full names with patronymics are refused</INVARIANT>
    <INVARIANT REVIEW="pack keeper">every record and every answer line carries a status of verified, reported or unverified, with its basis, and a verified one with the date it was seen</INVARIANT>
    <INVARIANT REVIEW="pack keeper">every declared proper name is used by the pack and none has the shape of a person's name</INVARIANT>
    <INVARIANT REVIEW="pack keeper">a search refusal or unfinished page cannot establish an empty result</INVARIANT>
  </FEATURE_REGION>

