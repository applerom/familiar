{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Familiar opt-in Cognito personal desk; owner-managed identities",
  "Parameters": {
    "FamilyTag": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9-]{1,40}"
    },
    "SessionKey": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 43
    },
    "AccessRuntimeKey": {
      "Type": "String",
      "Default": ""
    }
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "RetainExceptOnCreate",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireRateSlots",
              "Status": "Enabled",
              "Prefix": "feedback-rate/",
              "ExpirationInDays": 1
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "SiteOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "FeedbackOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-feedback"
          },
          "OriginAccessControlOriginType": "lambda",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Login": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-login"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Verify signed sessions and deny owner resources to readers",
          "Runtime": "cloudfront-js-2.0",
          "KeyValueStoreAssociations": [
            {
              "KeyValueStoreARN": {
                "Fn::GetAtt": [
                  "SessionStore",
                  "Arn"
                ]
              }
            }
          ]
        },
        "FunctionCode": "@EDGE@"
      }
    },
    "FeedbackRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SubjectFeedback",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${Bucket.Arn}/feedback/inbox/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/feedback/inbox/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": "feedback/inbox/*"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-feedback:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:DescribeUserPoolClient",
                    "cognito-idp:AdminGetUser",
                    "cognito-idp:ListUsers",
                    "cognito-idp:AdminCreateUser",
                    "cognito-idp:AdminSetUserPassword",
                    "cognito-idp:AdminUpdateUserAttributes",
                    "cognito-idp:AdminEnableUser",
                    "cognito-idp:AdminDisableUser",
                    "cognito-idp:AdminDeleteUser"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "UserPool",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/site/desk/feedback.json"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront-keyvaluestore:DescribeKeyValueStore",
                    "cloudfront-keyvaluestore:GetKey",
                    "cloudfront-keyvaluestore:PutKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SessionStore",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/site/graph.json"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "FeedbackLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-feedback"
        },
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "Feedback": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "FeedbackLog",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-feedback"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "FeedbackRole",
            "Arn"
          ]
        },
        "MemorySize": 128,
        "Timeout": 30,
        "Environment": {
          "Variables": {
            "BUCKET": {
              "Ref": "Bucket"
            },
            "USER_POOL": {
              "Ref": "UserPool"
            },
            "USER_CLIENT": {
              "Ref": "UserClient"
            },
            "SESSION_KEY": {
              "Ref": "SessionKey"
            },
            "COGNITO_DOMAIN": {
              "Fn::Sub": "${AWS::StackName}-${AWS::AccountId}.auth.${AWS::Region}.amazoncognito.com"
            },
            "SESSION_STORE": {
              "Fn::GetAtt": [
                "SessionStore",
                "Arn"
              ]
            }
          }
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ],
        "Code": {
          "ZipFile": "import base64\nimport json\nimport os\nimport uuid\nfrom datetime import datetime, timezone\nimport boto3\nfrom botocore.exceptions import ClientError\ns3 = boto3.client('s3')\ndef reply(status, value):\n    return {'statusCode': status, 'headers': {'content-type': 'application/json',\n        'cache-control': 'no-store', 'x-content-type-options': 'nosniff'},\n        'body': json.dumps(value)}\ndef feedback_handler(event, context):\n    principal = unsign(next((c.split('=', 1)[1] for c in event.get('cookies', []) if c.startswith('__Host-familiar=')), ''))\n    if not principal.get('sub') or principal['sub'] != event.get('headers', {}).get('x-familiar-user'):\n        return reply(403, {'error': 'principal'})\n    method = event.get('requestContext', {}).get('http', {}).get('method')\n    if event.get('rawPath') != '/api/feedback' or method not in {'POST', 'GET'}:\n        return reply(404, {'error': 'not_found'})\n    if method == 'GET':\n        query = event.get('queryStringParameters') or {}\n        subject = query.get('subject', '')\n        identities = set(query.get('ids', '').split(',')) - {''}\n        if not identities and (not subject or len(subject) > 200):\n            return reply(400, {'error': 'subject_required'})\n        items = []\n        try:\n            marks = json.loads(s3.get_object(Bucket=os.environ['BUCKET'], Key='site/desk/feedback.json')['Body'].read())\n        except ClientError:\n            marks = {}\n        for page in s3.get_paginator('list_objects_v2').paginate(Bucket=os.environ['BUCKET'], Prefix='feedback/inbox/'):\n            for obj in page.get('Contents', []):\n                item = json.loads(s3.get_object(Bucket=os.environ['BUCKET'], Key=obj['Key'])['Body'].read())\n                if principal['role'] != 'owner' and (item.get('kind') in {'correspondence_sent', 'correspondence_reply'} or item.get('screen') == 'correspondence' or item.get('page', '').split('?', 1)[0] == '/desk/correspondence.html' or item.get('sender', {}).get('sub') != principal['sub']):\n                    continue\n                if item.get('id') in identities or subject and any(item.get(k) == subject for k in ('subject', 'anchor', 'question', 'ask_id', 'person')):\n                    items.append({k: v for k, v in item.items() if k not in {'status', 'reply'}} | marks.get(item['id'], {}))\n        return reply(200, {'items': items})\n    headers = event.get('headers', {})\n    if headers.get('content-type', '').split(';')[0].strip().lower() != 'application/json':\n        return reply(415, {'error': 'json_required'})\n    raw = event.get('body') or ''\n    if len(raw) > 28000:\n        return reply(413, {'error': 'too_large'})\n    try:\n        body = base64.b64decode(raw, validate=True) if event.get('isBase64Encoded') else raw.encode('utf-8')\n        if len(body) > 20000:\n            return reply(413, {'error': 'too_large'})\n        data = json.loads(body)\n        allowed = ['anchor', 'ask_id', 'build', 'client_time', 'engine_version', 'feed', 'finding', 'id', 'kind', 'language', 'page', 'person', 'place', 'question', 'relation', 'screen', 'selection', 'step', 'subject', 'text', 'text_mode', 'viewport', 'where']\n        if not isinstance(data, dict):\n            raise ValueError()\n        if not all(isinstance(data.get(k, ''), str) for k in allowed):\n            raise ValueError()\n        if not 1 <= len(data.get('text', '').strip()) <= 6000 or len(data['text']) > 6000:\n            raise ValueError()\n        if not data.get('kind', '').strip():\n            raise ValueError()\n        if data.get('kind') == 'add_person' and (not data.get('anchor') or data.get('relation') not in {'child', 'spouse', 'parent', 'father', 'mother', 'sibling', 'relative', 'self'}):\n            raise ValueError()\n        person = data.get('new_person')\n        if person is not None and (data.get('kind') != 'add_person' or not isinstance(person, dict) or set(person) - {'surname', 'given', 'patronymic', 'maiden_surname', 'birth', 'birth_place', 'living', 'death', 'death_place', 'known_from', 'told_by', 'kin_words', 'note'}\n                or not all(isinstance(v, str) and len(v) <= (4000 if k == 'note' else 200) for k, v in person.items())\n                or person.get('living', '') not in {'', 'alive', 'dead', 'unknown'} or person.get('known_from', '') not in {'', 'memory', 'told', 'document'}):\n            raise ValueError()\n        if any(len(data.get(k, '')) > limit for k, limit in\n               [('page', 2048), ('person', 200), ('question', 200), ('ask_id', 200), ('finding', 1000), ('client_time', 40), ('subject', 200), ('anchor', 200), ('relation', 40), ('place', 200), ('where', 1000), ('screen', 80), ('feed', 200), ('step', 40), ('text_mode', 40), ('language', 40), ('selection', 300), ('viewport', 40), ('engine_version', 80), ('build', 100)]):\n            raise ValueError()\n        if not data.get('page', '').startswith('/') or data['page'].startswith('//'):\n            raise ValueError()\n        identity = str(uuid.UUID(data['id']))\n    except (ValueError, TypeError, KeyError, UnicodeError):\n        return reply(400, {'error': 'invalid_feedback'})\n    if (data['kind'] in {'correspondence_sent', 'correspondence_reply'} or data.get('screen') == 'correspondence' or data.get('page', '').split('?', 1)[0] == '/desk/correspondence.html') and (principal['role'] != 'owner' or not data.get('subject')):\n        return reply(403, {'error': 'owner_required'})\n    data = {k: v for k, v in data.items() if k in allowed or k == 'new_person'}\n    data['sender'] = {k: principal.get(k, '') for k in ('sub', 'username', 'role', 'person')}\n    key = 'feedback/inbox/' + identity + '.json'\n    existing = s3.list_objects_v2(Bucket=os.environ['BUCKET'], Prefix=key, MaxKeys=1)\n    if any(obj['Key'] == key for obj in existing.get('Contents', [])):\n        return reply(200, {'id': identity, 'duplicate': True})\n    data.update({'schema_version': 1, 'id': identity,\n        'received_at': datetime.now(timezone.utc).isoformat()})\n    try:\n        s3.put_object(Bucket=os.environ['BUCKET'], Key='feedback/inbox/' + identity + '.json',\n            Body=(json.dumps(data, ensure_ascii=False) + '\\n').encode('utf-8'),\n            IfNoneMatch='*', ContentType='application/json; charset=utf-8')\n    except ClientError as exc:\n        if exc.response['Error']['Code'] != 'PreconditionFailed':\n            raise\n        return reply(200, {'id': identity, 'duplicate': True})\n    return reply(201, {'id': identity})\n\ndef handler(event, context):\n    if event.get('rawPath', '').startswith('/auth/'):\n        return auth(event)\n    if event.get('rawPath', '').startswith('/api/access'):\n        return access_handler(event, context)\n    try:\n        return feedback_handler(event, context)\n    except (ValueError, KeyError, TypeError):\n        return reply(403, {'error': 'session_required'})\n"
        },
        "Layers": {
          "Fn::If": [
            "HasAccessRuntime",
            [
              {
                "Ref": "AccessRuntime"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "FeedbackUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Feedback"
        },
        "AuthType": "AWS_IAM",
        "InvokeMode": "BUFFERED"
      }
    },
    "Headers": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-headers"
          },
          "CustomHeadersConfig": {
            "Items": [
              {
                "Header": "X-Robots-Tag",
                "Value": "noindex, nofollow, noarchive",
                "Override": true
              }
            ]
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            }
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Private Familiar narrator desk",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "Bucket",
                  "RegionalDomainName"
                ]
              },
              "OriginPath": "/site",
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "SiteOAC"
              }
            },
            {
              "Id": "feedback",
              "DomainName": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Fn::GetAtt": [
                          "FeedbackUrl",
                          "FunctionUrl"
                        ]
                      }
                    ]
                  }
                ]
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "FeedbackOAC"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": {
              "Ref": "Headers"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "Login",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "feedback",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "ResponseHeadersPolicyId": {
                "Ref": "Headers"
              },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "Login",
                      "FunctionARN"
                    ]
                  }
                }
              ]
            },
            {
              "PathPattern": "/auth/*",
              "TargetOriginId": "feedback",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "ResponseHeadersPolicyId": {
                "Ref": "Headers"
              },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "Login",
                      "FunctionARN"
                    ]
                  }
                }
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Bucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Bucket.Arn}/site/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "AllowUrl": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Feedback"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "cloudfront.amazonaws.com",
        "FunctionUrlAuthType": "AWS_IAM",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        }
      }
    },
    "AllowInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Feedback"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "cloudfront.amazonaws.com",
        "InvokedViaFunctionUrl": true,
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        }
      }
    },
    "SessionStore": {
      "Type": "AWS::CloudFront::KeyValueStore",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-sessions"
        },
        "Comment": "Session signing key and revocation versions"
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-users"
        },
        "UserPoolTier": "ESSENTIALS",
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "MfaConfiguration": "OFF",
        "UserPoolTags": {
          "project": "familiar",
          "family": {
            "Ref": "FamilyTag"
          }
        },
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "EmailConfiguration": {
          "EmailSendingAccount": "COGNITO_DEFAULT"
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 6,
            "RequireLowercase": false,
            "RequireUppercase": false,
            "RequireNumbers": false,
            "RequireSymbols": false,
            "TemporaryPasswordValidityDays": 30
          }
        },
        "Schema": [
          {
            "Name": "role",
            "AttributeDataType": "String",
            "Mutable": true,
            "StringAttributeConstraints": {
              "MaxLength": "10"
            }
          },
          {
            "Name": "person",
            "AttributeDataType": "String",
            "Mutable": true,
            "StringAttributeConstraints": {
              "MaxLength": "200"
            }
          },
          {
            "Name": "session",
            "AttributeDataType": "String",
            "Mutable": true,
            "StringAttributeConstraints": {
              "MaxLength": "64"
            }
          }
        ]
      }
    },
    "UserClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "ClientName": "Familiar desk",
        "GenerateSecret": true,
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "aws.cognito.signin.user.admin"
        ],
        "CallbackURLs": [
          "https://localhost/auth/callback"
        ],
        "LogoutURLs": [
          "https://localhost/auth/login"
        ],
        "ReadAttributes": [
          "sub",
          "email",
          "custom:role",
          "custom:person",
          "custom:session"
        ],
        "WriteAttributes": [
          "email"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 1,
        "IdTokenValidity": 1,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "AccessToken": "hours",
          "IdToken": "hours",
          "RefreshToken": "days"
        },
        "ExplicitAuthFlows": [
          "ALLOW_REFRESH_TOKEN_AUTH"
        ]
      }
    },
    "UserDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "Domain": {
          "Fn::Sub": "${AWS::StackName}-${AWS::AccountId}"
        },
        "ManagedLoginVersion": 2
      }
    },
    "LoginBranding": {
      "Type": "AWS::Cognito::ManagedLoginBranding",
      "DependsOn": "UserDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "ClientId": {
          "Ref": "UserClient"
        },
        "UseCognitoProvidedValues": true
      }
    },
    "AccessRuntime": {
      "Type": "AWS::Lambda::LayerVersion",
      "Condition": "HasAccessRuntime",
      "Properties": {
        "Description": "Pinned AWS CRT 0.38.1 SigV4A signing, CPython 3.13 arm64; Apache-2.0",
        "CompatibleArchitectures": [
          "arm64"
        ],
        "CompatibleRuntimes": [
          "python3.13"
        ],
        "LicenseInfo": "Apache-2.0",
        "Content": {
          "S3Bucket": {
            "Ref": "Bucket"
          },
          "S3Key": {
            "Ref": "AccessRuntimeKey"
          }
        }
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Bucket"
      }
    },
    "Distribution": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "FeedbackUrl": {
      "Value": {
        "Fn::GetAtt": [
          "FeedbackUrl",
          "FunctionUrl"
        ]
      }
    },
    "UserPool": {
      "Value": {
        "Ref": "UserPool"
      }
    },
    "UserClient": {
      "Value": {
        "Ref": "UserClient"
      }
    },
    "SessionStore": {
      "Value": {
        "Fn::GetAtt": [
          "SessionStore",
          "Arn"
        ]
      }
    }
  },
  "Conditions": {
    "HasAccessRuntime": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AccessRuntimeKey"
            },
            ""
          ]
        }
      ]
    }
  }
}
