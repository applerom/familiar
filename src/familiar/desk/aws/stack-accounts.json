{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Familiar opt-in Cognito personal desk; owner-managed identities",
  "Parameters": {
    "FamilyTag": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9-]{1,40}"
    },
    "SessionKey": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 43
    },
    "AccessRuntimeKey": {
      "Type": "String",
      "Default": ""
    }
  },
  "Resources": {
    "Bucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "RetainExceptOnCreate",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireRateSlots",
              "Status": "Enabled",
              "Prefix": "feedback-rate/",
              "ExpirationInDays": 2
            },
            {
              "Id": "ExpireUnsentFiles",
              "Status": "Enabled",
              "Prefix": "feedback/upload/",
              "ExpirationInDays": 2
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "SiteOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "FeedbackOAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-feedback"
          },
          "OriginAccessControlOriginType": "lambda",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Login": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-login"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Verify signed sessions and deny owner resources to readers",
          "Runtime": "cloudfront-js-2.0",
          "KeyValueStoreAssociations": [
            {
              "KeyValueStoreARN": {
                "Fn::GetAtt": [
                  "SessionStore",
                  "Arn"
                ]
              }
            }
          ]
        },
        "FunctionCode": "@EDGE@"
      }
    },
    "FeedbackRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SubjectFeedback",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${Bucket.Arn}/feedback/inbox/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/feedback/inbox/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": "feedback/inbox/*"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-feedback:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:DescribeUserPoolClient",
                    "cognito-idp:AdminGetUser",
                    "cognito-idp:ListUsers",
                    "cognito-idp:AdminCreateUser",
                    "cognito-idp:AdminSetUserPassword",
                    "cognito-idp:AdminUpdateUserAttributes",
                    "cognito-idp:AdminEnableUser",
                    "cognito-idp:AdminDisableUser",
                    "cognito-idp:AdminDeleteUser"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "UserPool",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/site/desk/feedback.json"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/site/desk/asks-links.json"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudfront-keyvaluestore:DescribeKeyValueStore",
                    "cloudfront-keyvaluestore:GetKey",
                    "cloudfront-keyvaluestore:PutKey"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "SessionStore",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/site/graph.json"
                  }
                },
                {
                  "Sid": "AttachmentParts",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/feedback-rate/upload/v2/*"
                  }
                },
                {
                  "Sid": "AttachmentOriginals",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/feedback/attachments/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "s3:if-none-match": "*"
                    }
                  }
                },
                {
                  "Sid": "AttachmentQuota",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/feedback-rate/v2/*"
                  }
                },
                {
                  "Sid": "AttachmentLogout",
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${Bucket.Arn}/feedback-rate/revoked/*"
                  }
                },
                {
                  "Sid": "AttachmentList",
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": {
                    "Fn::GetAtt": [
                      "Bucket",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "feedback-rate/upload/v2/*",
                        "feedback/attachments/*",
                        "feedback-rate/v2/*",
                        "feedback-rate/revoked/*"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "FeedbackLog": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-feedback"
        },
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "Feedback": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "FeedbackLog",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-feedback"
        },
        "Runtime": "python3.13",
        "Architectures": [
          "arm64"
        ],
        "Handler": "index.handler",
        "Role": {
          "Fn::GetAtt": [
            "FeedbackRole",
            "Arn"
          ]
        },
        "MemorySize": 1024,
        "Timeout": 120,
        "Environment": {
          "Variables": {
            "BUCKET": {
              "Ref": "Bucket"
            },
            "USER_POOL": {
              "Ref": "UserPool"
            },
            "USER_CLIENT": {
              "Ref": "UserClient"
            },
            "SESSION_KEY": {
              "Ref": "SessionKey"
            },
            "COGNITO_DOMAIN": {
              "Fn::Sub": "${AWS::StackName}-${AWS::AccountId}.auth.${AWS::Region}.amazoncognito.com"
            },
            "SESSION_STORE": {
              "Fn::GetAtt": [
                "SessionStore",
                "Arn"
              ]
            }
          }
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ],
        "Code": {
          "ZipFile": "def handler(event, context):\n    return {'statusCode': 503, 'body': 'Desk setup in progress'}"
        },
        "Layers": {
          "Fn::If": [
            "HasAccessRuntime",
            [
              {
                "Ref": "AccessRuntime"
              }
            ],
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "FeedbackUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Feedback"
        },
        "AuthType": "AWS_IAM",
        "InvokeMode": "BUFFERED"
      }
    },
    "Headers": {
      "Type": "AWS::CloudFront::ResponseHeadersPolicy",
      "Properties": {
        "ResponseHeadersPolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-headers"
          },
          "CustomHeadersConfig": {
            "Items": [
              {
                "Header": "X-Robots-Tag",
                "Value": "noindex, nofollow, noarchive",
                "Override": true
              }
            ]
          },
          "SecurityHeadersConfig": {
            "ContentTypeOptions": {
              "Override": true
            },
            "FrameOptions": {
              "FrameOption": "DENY",
              "Override": true
            },
            "ReferrerPolicy": {
              "ReferrerPolicy": "no-referrer",
              "Override": true
            },
            "StrictTransportSecurity": {
              "AccessControlMaxAgeSec": 31536000,
              "Override": true
            }
          }
        }
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Private Familiar narrator desk",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "ViewerCertificate": {
            "CloudFrontDefaultCertificate": true
          },
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "Bucket",
                  "RegionalDomainName"
                ]
              },
              "OriginPath": "/site",
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "SiteOAC"
              }
            },
            {
              "Id": "feedback",
              "DomainName": {
                "Fn::Select": [
                  2,
                  {
                    "Fn::Split": [
                      "/",
                      {
                        "Fn::GetAtt": [
                          "FeedbackUrl",
                          "FunctionUrl"
                        ]
                      }
                    ]
                  }
                ]
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginReadTimeout": 60,
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              },
              "OriginAccessControlId": {
                "Ref": "FeedbackOAC"
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "https-only",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": {
              "Ref": "Headers"
            },
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "Login",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "PathPattern": "/api/*",
              "TargetOriginId": "feedback",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "ResponseHeadersPolicyId": {
                "Ref": "Headers"
              },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "Login",
                      "FunctionARN"
                    ]
                  }
                }
              ]
            },
            {
              "PathPattern": "/auth/*",
              "TargetOriginId": "feedback",
              "ViewerProtocolPolicy": "https-only",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac",
              "ResponseHeadersPolicyId": {
                "Ref": "Headers"
              },
              "FunctionAssociations": [
                {
                  "EventType": "viewer-request",
                  "FunctionARN": {
                    "Fn::GetAtt": [
                      "Login",
                      "FunctionARN"
                    ]
                  }
                }
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "familiar"
          },
          {
            "Key": "family",
            "Value": {
              "Ref": "FamilyTag"
            }
          }
        ]
      }
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Bucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Bucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Bucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${Bucket.Arn}/site/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "AllowUrl": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Feedback"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "cloudfront.amazonaws.com",
        "FunctionUrlAuthType": "AWS_IAM",
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        }
      }
    },
    "AllowInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "Feedback"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "cloudfront.amazonaws.com",
        "InvokedViaFunctionUrl": true,
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
        }
      }
    },
    "SessionStore": {
      "Type": "AWS::CloudFront::KeyValueStore",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-sessions"
        },
        "Comment": "Session signing key and revocation versions"
      }
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-users"
        },
        "UserPoolTier": "ESSENTIALS",
        "AdminCreateUserConfig": {
          "AllowAdminCreateUserOnly": true
        },
        "MfaConfiguration": "OFF",
        "UserPoolTags": {
          "project": "familiar",
          "family": {
            "Ref": "FamilyTag"
          }
        },
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "EmailConfiguration": {
          "EmailSendingAccount": "COGNITO_DEFAULT"
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 6,
            "RequireLowercase": false,
            "RequireUppercase": false,
            "RequireNumbers": false,
            "RequireSymbols": false,
            "TemporaryPasswordValidityDays": 30
          }
        },
        "Schema": [
          {
            "Name": "role",
            "AttributeDataType": "String",
            "Mutable": true,
            "StringAttributeConstraints": {
              "MaxLength": "10"
            }
          },
          {
            "Name": "person",
            "AttributeDataType": "String",
            "Mutable": true,
            "StringAttributeConstraints": {
              "MaxLength": "200"
            }
          },
          {
            "Name": "session",
            "AttributeDataType": "String",
            "Mutable": true,
            "StringAttributeConstraints": {
              "MaxLength": "64"
            }
          }
        ]
      }
    },
    "UserClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "ClientName": "Familiar desk",
        "GenerateSecret": true,
        "SupportedIdentityProviders": [
          "COGNITO"
        ],
        "AllowedOAuthFlowsUserPoolClient": true,
        "AllowedOAuthFlows": [
          "code"
        ],
        "AllowedOAuthScopes": [
          "openid",
          "aws.cognito.signin.user.admin"
        ],
        "CallbackURLs": [
          "https://localhost/auth/callback"
        ],
        "LogoutURLs": [
          "https://localhost/auth/login"
        ],
        "ReadAttributes": [
          "sub",
          "email",
          "custom:role",
          "custom:person",
          "custom:session"
        ],
        "WriteAttributes": [
          "email"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 1,
        "IdTokenValidity": 1,
        "RefreshTokenValidity": 1,
        "TokenValidityUnits": {
          "AccessToken": "hours",
          "IdToken": "hours",
          "RefreshToken": "days"
        },
        "ExplicitAuthFlows": [
          "ALLOW_REFRESH_TOKEN_AUTH"
        ]
      }
    },
    "UserDomain": {
      "Type": "AWS::Cognito::UserPoolDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "Domain": {
          "Fn::Sub": "${AWS::StackName}-${AWS::AccountId}"
        },
        "ManagedLoginVersion": 2
      }
    },
    "LoginBranding": {
      "Type": "AWS::Cognito::ManagedLoginBranding",
      "DependsOn": "UserDomain",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "ClientId": {
          "Ref": "UserClient"
        },
        "UseCognitoProvidedValues": true
      }
    },
    "AccessRuntime": {
      "Type": "AWS::Lambda::LayerVersion",
      "Condition": "HasAccessRuntime",
      "Properties": {
        "Description": "Pinned AWS CRT 0.38.1 SigV4A signing, CPython 3.13 arm64; Apache-2.0",
        "CompatibleArchitectures": [
          "arm64"
        ],
        "CompatibleRuntimes": [
          "python3.13"
        ],
        "LicenseInfo": "Apache-2.0",
        "Content": {
          "S3Bucket": {
            "Ref": "Bucket"
          },
          "S3Key": {
            "Ref": "AccessRuntimeKey"
          }
        }
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Bucket"
      }
    },
    "Distribution": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "Url": {
      "Value": {
        "Fn::Sub": "https://${Distribution.DomainName}"
      }
    },
    "FeedbackUrl": {
      "Value": {
        "Fn::GetAtt": [
          "FeedbackUrl",
          "FunctionUrl"
        ]
      }
    },
    "UserPool": {
      "Value": {
        "Ref": "UserPool"
      }
    },
    "UserClient": {
      "Value": {
        "Ref": "UserClient"
      }
    },
    "SessionStore": {
      "Value": {
        "Fn::GetAtt": [
          "SessionStore",
          "Arn"
        ]
      }
    }
  },
  "Conditions": {
    "HasAccessRuntime": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AccessRuntimeKey"
            },
            ""
          ]
        }
      ]
    }
  }
}
